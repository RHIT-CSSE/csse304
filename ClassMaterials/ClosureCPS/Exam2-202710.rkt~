;; QUESTION 4 UNLET - 15 points
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; Implement the special form
;;
;; (unlet body)
;;
;; Within body, the nearest enclosing scope does not apply.  That
;; scope is available again in the rest of the expression outside the
;; unlet.  This applies to variables bound by a let and to variables
;; bound by a lambda invocation.
;;
;; A let with several bindings is a single scope, and a lambda with
;; several parameters is a single scope.  For example:
;;
;; (let ((x 1) (y 2))
;;   (let ((x 10) (y 20))
;;     (unlet (+ x y))))       ; evaluates to 3
;;
;; ((lambda (x y)
;;    (let ((x 10) (y 20))
;;      (unlet (+ x y))))
;;  1 2)                       ; evaluates to 3
;;
;; A let* is equivalent to nested single-binding lets, so it creates
;; one scope per binding.  One unlet removes only the scope of the
;; last binding, and nested unlets move outward one binding at a time:
;;
;; (let* ((x 1) (x 2)) (unlet x))   ; evaluates to 1
;;
;; (let ((x 0))
;;   (let* ((x 1) (x 2))
;;     (unlet (unlet x))))          ; evaluates to 0
;;
;; Empty scopes are ignored.  A zero-argument lambda, a begin with
;; more than one expression (if you happened to implment it that way),
;; or an empty let with more than one expression creates an empty
;; scope, but unlet looks past it:
;;
;; (let ((x 1))
;;   (let ((x 2))
;;     ((lambda () (unlet x)))))        ; evaluates to 1
;;
;; You may nest unlet to remove more than one scope:
;;
;; (let ((x 1))
;;   (let ((x 2))
;;     (let ((x 3))
;;       (unlet (unlet x)))))       ; evaluates to 1
;;
;; Within the unlet body, shadowed variables become visible again and
;; variables that were defined only in the removed scope become
;; undefined.
;;
;; None of the tests use letrec or named let, so you do not need to
;; consider how unlet interacts with those forms.
;;
;; Implement this feature in your interpreter (not with syntax-expand).

;;--------  Used by the testing mechanism   ------------------

(define-syntax nyi
  (syntax-rules ()
    ([_]
     [error "nyi"])))
